<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hud_bg"
    android:fitsSystemWindows="true">

    <!-- ============== PREVIEW: CameraX-managed, CCD shader injected via CameraEffect ============== -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/modeRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- PLAY/EDIT: recorded scenes played back like a tape. -->
    <FrameLayout
        android:id="@+id/playbackContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/black"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/previewView"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView">

        <!-- Fits the clip into the LCD region and turns it with the phone, like the OSD. -->
        <at.sturq.ccdcam.firmware.PlaybackView
            android:id="@+id/playbackView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- HC90E touch-panel display (P-MENU, MENU, indicators). Phone UI only, never recorded. -->
    <at.sturq.ccdcam.firmware.FirmwareOsdView
        android:id="@+id/firmwareOsd"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/previewView"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView" />

    <!-- ============== ANDROID-NATIVE CONTROLS BELOW PREVIEW ============== -->

    <!-- mode toggle -->
    <LinearLayout
        android:id="@+id/modeRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="10dp"
        android:paddingBottom="6dp"
        app:layout_constraintBottom_toTopOf="@id/controlRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/modePhoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="22dp"
            android:paddingVertical="6dp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:textSize="12sp"
            android:letterSpacing="0.18"
            android:textColor="@color/hud_dim"
            android:background="?attr/selectableItemBackground"
            android:text="MEMORY"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/modeVideo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="22dp"
            android:paddingVertical="6dp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:textSize="12sp"
            android:letterSpacing="0.18"
            android:textColor="@color/hud_accent"
            android:background="?attr/selectableItemBackground"
            android:text="TAPE"
            tools:ignore="HardcodedText" />

        <!-- POWER switch lamps: MEMORY / TAPE / PLAY/EDIT. -->
        <TextView
            android:id="@+id/modePlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="22dp"
            android:paddingVertical="6dp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:textSize="12sp"
            android:letterSpacing="0.18"
            android:textColor="@color/hud_dim"
            android:background="?attr/selectableItemBackground"
            android:text="PLAY/EDIT"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/controlRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/shutterBtn"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_gravity="center"
            android:background="@drawable/shutter_video"
            android:contentDescription="@string/shutter" />

        <!-- Camcorder body controls outside the emulated LCD. -->
        <LinearLayout
            android:id="@+id/hcControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="24dp"
            android:orientation="vertical">

            <!-- WIDE SELECT hardware button (16:9 / 4:3). -->
            <TextView
                android:id="@+id/wideSelectBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textSize="11sp"
                android:textColor="@color/hud_accent"
                android:letterSpacing="0.08"
                android:background="?attr/selectableItemBackground"
                android:text="WIDE 16:9"
                tools:ignore="HardcodedText" />

            <!-- NIGHTSHOT switch (visual emulation) and LIGHT (phone torch): body controls. -->
            <TextView
                android:id="@+id/nightShotBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textSize="11sp"
                android:textColor="@color/hud_dim"
                android:letterSpacing="0.08"
                android:background="?attr/selectableItemBackground"
                android:text="NIGHTSHOT"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/lightBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textSize="11sp"
                android:textColor="@color/hud_dim"
                android:letterSpacing="0.08"
                android:background="?attr/selectableItemBackground"
                android:text="LIGHT"
                tools:ignore="HardcodedText" />

            <!-- Delivered frame rate (measured), e.g. "PAL 25p" or "30p · 25p n/a". -->
            <TextView
                android:id="@+id/fpsTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:fontFamily="monospace"
                android:textSize="10sp"
                android:textColor="@color/hud_dim"
                android:letterSpacing="0.08"
                android:text="--p"
                tools:ignore="HardcodedText" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/flipBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="36dp"
            android:background="@drawable/round_button_bg"
            android:src="@drawable/ic_flip"
            android:padding="12dp"
            android:contentDescription="@string/switch_camera" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
